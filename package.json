{
  "name": "storepilot",
  "version": "1.0.0",
  "description": "",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "db:migrate": "tsx scripts/migrate.ts",
    "admin:create": "tsx scripts/admin.ts",
    "worker": "tsx scripts/worker.ts",
    "setup:local": "tsx scripts/setup-local.ts",
    "test": "tsx --test tests/*.test.ts",
    "admin:bootstrap": "tsx scripts/bootstrap-admin.ts",
    "config:key": "tsx scripts/config-key.ts",
    "verify:images": "tsx --test tests/workflow.test.ts",
    "services:start": "node scripts/services.mjs start",
    "services:stop": "node scripts/services.mjs stop",
    "services:status": "node scripts/services.mjs status",
    "verify": "npm run typecheck && npm test && npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xSILENCEx/StorePilot.git"
  },
  "keywords": [],
  "author": "",
  "bugs": {
    "url": "https://github.com/xSILENCEx/StorePilot/issues"
  },
  "homepage": "https://github.com/xSILENCEx/StorePilot#readme",
  "private": true,
  "dependencies": {
    "@mantine/core": "^9.8.0",
    "@mantine/hooks": "^9.8.0",
    "@mantine/notifications": "^9.8.0",
    "@next/env": "^16.4.6",
    "better-auth": "^1.7.22",
    "better-sqlite3": "^13.1.1",
    "drizzle-orm": "^0.45.4",
    "lucide-react": "^0.468.0",
    "next": "^16.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "sharp": "^0.35.5",
    "yazl": "^3.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/yazl": "^3.3.1",
    "prettier": "^3.10.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.0"
  }
