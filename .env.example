DATABASE_URL=postgresql://storepilot:CHANGE_ME@127.0.0.1:55432/storepilot
BETTER_AUTH_URL=http://127.0.0.1:3000
BETTER_AUTH_SECRET=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
STORAGE_PATH=./data/assets
# 仅在执行 npm run admin:create 时提供，不要长期保留管理员明文密码
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=

# 凭据 AES-256-GCM 主密钥；运行 npm run config:key 自动生成到 .env.local。
# 首次 setup:local 也会生成；切勿替换已用于加密凭据的主密钥。
# STOREPILOT_MASTER_KEY=32_BYTE_RANDOM_KEY_IN_BASE64
